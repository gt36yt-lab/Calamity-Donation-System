# ─────────────────────────────────────────────────────────
#  TranspaRelief — environment variables
#  Copy this file to .env and fill in your values.
#  All variables must be prefixed with VITE_ to be exposed
#  to the browser by Vite.
# ─────────────────────────────────────────────────────────

# Stellar network: "testnet" or "public"
VITE_STELLAR_NETWORK=testnet

# LGU treasury Stellar wallet public key.
# This is the destination address that receives withdrawn funds
# from the Soroban contract.
VITE_LGU_WALLET=GDGP4K3Z3IU3NBXYY57TRKBBV4EDHJEBNRRDORCRDMA3FFJUF4PEHGV5

# Deployed CalamityDonation Soroban contract ID (C… address).
# Deploy the Rust contract first — see contract/README.md — then
# paste the resulting contract address here.
VITE_CONTRACT_ID=
